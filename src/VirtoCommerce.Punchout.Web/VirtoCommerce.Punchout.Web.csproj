<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.Punchout.Core\VirtoCommerce.Punchout.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Punchout.Data\VirtoCommerce.Punchout.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Punchout.Data.MySql\VirtoCommerce.Punchout.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Punchout.Data.PostgreSql\VirtoCommerce.Punchout.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Punchout.Data.SqlServer\VirtoCommerce.Punchout.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.Punchout.ExperienceApi\VirtoCommerce.Punchout.ExperienceApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\blades\" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>
